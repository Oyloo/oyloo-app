    "No accounts linked": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Счета не привязаны"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konti nav piesaistīti"
          }
        }
      }
    },
    "No bank account is linked to this account yet, so there are no numbers here — zeros would look like a real balance. Ask a parent to link one.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К этому аккаунту ещё не привязан ни один банковский счёт, поэтому цифр здесь нет — и мы не показываем нули, чтобы их не приняли за настоящий баланс. Попроси родителей привязать счёт."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šim kontam vēl nav piesaistīts neviens bankas konts, tāpēc šeit nav skaitļu — nulles izskatītos pēc īsta atlikuma. Palūdz vecākiem piesaistīt kontu."
          }
        }
      }
    },
    "No bank account linked yet": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Банковский счёт ещё не привязан"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bankas konts vēl nav piesaistīts"
          }
        }
      }
    },
    "No captures yet": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захватов пока нет"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ierakstu vēl nav"
          }
        }
      }
    },
    "No data since %@ — %lld days. Either nothing happened on the account, or the bank sync has stopped.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные не обновлялись с %1$@ — %2$lld дн. Либо по счёту правда ничего не происходило, либо остановилась синхронизация с банком."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati nav atjaunināti kopš %1$@ — %2$lld d. Vai nu kontā tiešām nekas nenotika, vai apstājusies sinhronizācija ar banku."
          }
        }
      }
    },
    "No goals yet. What are you saving for?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целей пока нет. На что копишь?"
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mērķu vēl nav. Kam krāj?"
          }
        }
      }
    },
