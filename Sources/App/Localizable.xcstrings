    "A non-euro currency is linked (%@). Everything is added up as euros, so the sums above cannot be trusted.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К счёту привязана валюта кроме евро (%@). Всё складывается как евро, так что суммам выше верить нельзя."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesaistīta valūta, kas nav eiro (%@). Viss tiek saskaitīts kā eiro, tāpēc augstāk redzamajām summām nevar uzticēties."
          }
        }
      }
    },
