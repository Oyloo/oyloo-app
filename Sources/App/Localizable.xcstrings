    "Set the server address in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите адрес сервера в Настройках."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Norādiet servera adresi iestatījumos."
          }
        }
      }
    },
    "Sign in to see this.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы это увидеть."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierakstieties, lai to redzētu."
          }
        }
      }
    },
    "The server answered %lld.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер ответил %lld."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveris atbildēja %lld."
          }
        }
      }
    },
    "The server refused the sign-in. Sign in again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер отклонил вход. Войдите снова."
